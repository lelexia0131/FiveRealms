{
  "name": "five-realms",
  "version": "1.3.1",
  "description": "FiveRealms desktop game",
  "author": "lelexia",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.fiverealms.game",
    "productName": "FiveRealms",
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/ui/five-realms.ico",
      "target": "nsis",
      "artifactName": "FiveRealms-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/ui/five-realms.ico",
      "uninstallerIcon": "assets/ui/five-realms.ico",
      "include": "build/installer.nsh"
    }
  }
}
